{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageOnlyProjectEC2",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances", "ec2:TerminateInstances", "ec2:StartInstances", "ec2:StopInstances",
        "ec2:CreateTags", "ec2:CreateSecurityGroup", "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress", "ec2:DeleteSecurityGroup", "ec2:CreateKeyPair",
        "ec2:DeleteKeyPair"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "${AWS_REGION}" } }
    },
    {
      "Sid": "ReadOnlyEC2",
      "Effect": "Allow",
      "Action": ["ec2:Describe*"],
      "Resource": "*"
    },
    {
      "Sid": "SmallInstanceTypesOnly",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": { "StringNotEquals": { "ec2:InstanceType": ["t2.micro", "t3.micro", "t4g.micro"] } }
    },
    {
      "Sid": "ProjectS3Buckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::cloudops-assets-*", "arn:aws:s3:::cloudops-assets-*/*"]
    },
    {
      "Sid": "ListBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets", "s3:GetBucketLocation"],
      "Resource": "*"
    },
    {
      "Sid": "ProjectParameters",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:GetParameter*", "ssm:DeleteParameter*", "ssm:DescribeParameters", "ssm:AddTagsToResource"],
      "Resource": "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter/cloudops/*"
    },
    {
      "Sid": "ProjectRDS",
      "Effect": "Allow",
      "Action": ["rds:CreateDBInstance", "rds:DeleteDBInstance", "rds:Describe*", "rds:ModifyDBInstance", "rds:AddTagsToResource", "rds:CreateDBSubnetGroup", "rds:DeleteDBSubnetGroup"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "${AWS_REGION}" } }
    },
    {
      "Sid": "ProjectIAMRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:PutRolePolicy", "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile", "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile",
        "iam:GetInstanceProfile", "iam:PassRole", "iam:TagRole"
      ],
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/cloudops-*",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:instance-profile/cloudops-*"
      ]
    },
    {
      "Sid": "Monitoring",
      "Effect": "Allow",
      "Action": ["cloudwatch:*", "logs:*", "sns:CreateTopic", "sns:Subscribe", "sns:DeleteTopic", "sns:ListTopics"],
      "Resource": "*"
    },
    {
      "Sid": "CostVisibility",
      "Effect": "Allow",
      "Action": ["ce:GetCostAndUsage", "budgets:*", "servicequotas:ListServiceQuotas", "servicequotas:GetServiceQuota", "sts:GetCallerIdentity"],
      "Resource": "*"
    }
  ]
}
