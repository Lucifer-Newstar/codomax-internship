# Copy to .env for local runs:  cp .env.example .env
# .env is git-ignored. NEVER commit real values.

# --- Application ---
APP_ENV=development            # development | production | test
APP_PORT=8000
APP_VERSION=1.0.0
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json (for CloudWatch / docker logs) | text (easier to read locally)
SECRET_KEY=change-me-in-production   # Flask session signing key; generate with: openssl rand -hex 32

# --- Database (option 1: single URL) ---
DATABASE_URL=postgresql://cloudops:localdevpass@localhost:5432/cloudops

# --- Database (option 2: separate parts, used when DATABASE_URL is empty) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudops
DB_USER=cloudops
DB_PASSWORD=localdevpass
# DB_PASSWORD_FILE=/run/secrets/db_password      # docker secrets style: read password from a file
# DB_PASSWORD_SSM_PARAMETER=/cloudops/prod/db_password   # AWS SSM SecureString (needs boto3 + IAM)
DB_SSLMODE=prefer              # use "require" against RDS

# --- Optional: static assets served from S3 instead of the app ---
# ASSET_BASE_URL=https://cloudops-assets-123456789012.s3.ap-south-1.amazonaws.com/static
