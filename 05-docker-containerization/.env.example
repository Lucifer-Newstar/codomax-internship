# docker compose settings — copy to .env (git-ignored) and change the password.
POSTGRES_DB=cloudops
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=change-me-locally      # e.g. openssl rand -hex 16

APP_ENV=production                        # production = SECRET_KEY must be real
SECRET_KEY=change-me-too                  # openssl rand -hex 32
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json
HTTP_PORT=8080                            # host port nginx listens on
