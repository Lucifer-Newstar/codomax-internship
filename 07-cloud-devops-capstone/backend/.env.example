# Backend configuration (copy to .env for local runs; .env is git-ignored)
APP_ENV=development
APP_PORT=8000
APP_VERSION=2.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json
SECRET_KEY=change-me                     # openssl rand -hex 32 in production
DATABASE_URL=postgresql://cloudops:localdevpass@localhost:5432/cloudops
# or DB_HOST/DB_PORT/DB_NAME/DB_USER + DB_PASSWORD | DB_PASSWORD_FILE | DB_PASSWORD_SSM_PARAMETER
DB_SSLMODE=prefer
# TASK_STORE=memory                      # unit tests only
