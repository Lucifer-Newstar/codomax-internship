# docker compose configuration for the capstone (copy to docker/.env — git-ignored)
POSTGRES_DB=cloudops
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=change-me            # openssl rand -hex 16
SECRET_KEY=change-me-too               # openssl rand -hex 32
APP_ENV=production
APP_VERSION=2.0.0
LOG_LEVEL=INFO
HTTP_PORT=8080                         # host port for the UI
# production only (docker-compose.prod.yml): images pushed by CI
IMAGE_API=ghcr.io/lucifer-newstar/cloudops-api:latest
IMAGE_UI=ghcr.io/lucifer-newstar/cloudops-ui:latest
GIT_SHA=dev
